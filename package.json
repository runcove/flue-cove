{
  "name": "@runcove/flue",
  "version": "0.3.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runcove/flue-cove.git"
  },
  "description": "Flue sandbox adapter backed by Cove microVMs",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-reporter=spec --test-timeout=60000 \"test/*.test.ts\"",
    "test:integration": "node --test --test-reporter=spec --test-concurrency=1 \"test/integration/*.test.ts\"",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.2.2"
  },
  "dependencies": {
    "@runcove/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@flue/runtime": "2.2.2",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
